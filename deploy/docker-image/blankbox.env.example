# Direct access on this computer. Use 0.0.0.0 for trusted home-network access.
BLANKBOX_BIND_ADDRESS=127.0.0.1
BLANKBOX_PUBLISHED_PORT=25265
# New libraries use 1000. The update helper retains existing IDs automatically.
BLANKBOX_UID=1000
BLANKBOX_GID=1000
# Keep a custom COMPOSE_PROJECT_NAME here when updating an existing installation.
# COMPOSE_PROJECT_NAME=blankbox
