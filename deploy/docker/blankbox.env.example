# Copy this file to .env before starting Blank Box.
# Keep 127.0.0.1 for access from this computer only.
# Use 0.0.0.0 only when you intentionally want access from your trusted LAN.
BLANKBOX_BIND_ADDRESS=127.0.0.1
BLANKBOX_PUBLISHED_PORT=25265
# The default user for a new installation. Check your host IDs with id -u / id -g.
# To choose another UID, use a correctly owned data bind folder as shown in the
# Docker guide. These settings do not change existing data ownership.
# An update preserves the existing installation's user; do not change these IDs
# to move an existing library between users.
BLANKBOX_UID=1000
BLANKBOX_GID=1000
