[Unit]
Description=Blank Box local network name
Documentation=https://blankbox.org/self-hosted/
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
Type=simple
Environment=BLANKBOX_LOCAL_NAME=blankbox.local
Environment=BLANKBOX_LOCAL_PORT=25265
EnvironmentFile=-/etc/blankbox/local-name.env
ExecStart=/usr/local/libexec/blankbox-local-name
Restart=on-failure
RestartSec=5s
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
